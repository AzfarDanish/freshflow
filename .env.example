# FreshFlow connects to the Supabase-hosted PostgreSQL project in every
# environment. Copy this file to .env.local and set DATABASE_URL to its
# connection string (Supabase dashboard → Project Settings → Database →
# Connection string, session pooler URI with sslmode=no-verify — node-pg treats
# sslmode=require as strict verify-full and rejects Supabase's certificate chain).
# For hosted runs, keep the same value in Replit Secrets; never expose it client-side.
DATABASE_URL=

# Server-only key used to sign Owner/Staff preview-role cookies.
# For local development, generate one with: openssl rand -hex 32
SESSION_SECRET=

# Server-only API key used by the read-only, evidence-grounded assistant.
# Configure it through Replit Secrets; never expose it to the client.
OPENROUTER_API_KEY=

# Migration-only value: overrides the DATABASE_URL fallback to read rows from a
# previous database (scripts/migrate-postgres-to-supabase.ts, one-time
# PostgreSQL → Supabase copy). Never used by the app at runtime and never
# exposed to the client. The copy destination stays Supabase-hosted PostgreSQL.
SOURCE_DATABASE_URL=
SUPABASE_DATABASE_URL=
