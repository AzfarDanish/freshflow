# Local development: create a PostgreSQL database, copy this file to .env.local,
# and set DATABASE_URL to its connection string. Replit supplies its managed URL.
DATABASE_URL=

# Server-only key used to sign Owner/Staff preview-role cookies.
# For local development, generate one with: openssl rand -hex 32
SESSION_SECRET=

# Server-only API key used by the read-only, evidence-grounded assistant.
# Configure it through Replit Secrets; never expose it to the client.
OPENROUTER_API_KEY=

# Temporary, server-only values used only when importing legacy Supabase data.
# Do not configure these for normal FreshFlow operation or expose them to the client.
LEGACY_SUPABASE_URL=
LEGACY_SUPABASE_SERVICE_ROLE_KEY=
